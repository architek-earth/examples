{
  "name": "AU Price Monitor: Coles, Woolworths, ALDI Price Alerts (Apify)",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://api.apify.com/v2/acts/architekture~au-price-monitor/run-sync-get-dataset-items",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{var.organization.APIFY_TOKEN}}"
          }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\n  \"products\": [\n    \"a2 full cream milk 2l\",\n    \"helga's wholemeal bread\",\n    \"western star butter 500g\",\n    \"free range eggs 12 pack\",\n    \"bananas\",\n    \"weet-bix 1.2kg\",\n    \"white sugar 2kg\",\n    \"heinz baked beans 555g\",\n    \"bega peanut butter\",\n    \"tim tam original\"\n  ],\n  \"freeTier\": true\n}",
        "parseResponse": true,
        "timeout": "300",
        "shareCookies": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "followAllRedirects": false
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
